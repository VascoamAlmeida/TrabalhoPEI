<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    
    <xs:element name="Root">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="data">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="record" type="recordType" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <xs:complexType name="recordType">
        <xs:sequence>
            <xs:element name="_id" type="xs:string"/>
            <xs:element name="total_per_customer" type="xs:decimal"/>
            <xs:element name="num_invoices" type="xs:integer"/>
            <xs:element name="sum_items" type="xs:integer"/>
        </xs:sequence>
    </xs:complexType>
    
</xs:schema>
